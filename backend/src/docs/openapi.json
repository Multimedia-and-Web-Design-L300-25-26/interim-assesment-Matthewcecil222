{
  "openapi": "3.0.3",
  "info": {
    "title": "Coinbase Clone Backend API",
    "version": "1.0.0",
    "description": "REST API for authentication, protected profile access, and cryptocurrency data."
  },
  "servers": [
    {
      "url": "http://localhost:5000"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "API is running"
          }
        }
      }
    },
    "/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true
        },
        "responses": {
          "201": {
            "description": "User registered"
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Log in a user",
        "requestBody": {
          "required": true
        },
        "responses": {
          "200": {
            "description": "Login successful"
          }
        }
      }
    },
    "/profile": {
      "get": {
        "summary": "Get the current user's profile",
        "responses": {
          "200": {
            "description": "Profile returned"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/crypto": {
      "get": {
        "summary": "Get all cryptocurrencies",
        "responses": {
          "200": {
            "description": "List returned"
          }
        }
      },
      "post": {
        "summary": "Create a cryptocurrency",
        "requestBody": {
          "required": true
        },
        "responses": {
          "201": {
            "description": "Cryptocurrency created"
          }
        }
      }
    },
    "/crypto/gainers": {
      "get": {
        "summary": "Get top gainers",
        "responses": {
          "200": {
            "description": "Sorted list returned"
          }
        }
      }
    },
    "/crypto/new": {
      "get": {
        "summary": "Get new listings",
        "responses": {
          "200": {
            "description": "Sorted list returned"
          }
        }
      }
    }
  }
}
